{
  "expo": {
    "name": "REGIME",
    "slug": "regime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "regime",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08081A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.regime.app"
    },
    "android": {
      "package": "com.regime.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "REGIME accesses your photo library so you can choose images for your profile and community posts.",
          "cameraPermission": "REGIME accesses your camera when you choose to capture a new photo for your profile or posts."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://regime.app/privacy",
      "eulaNote": "Replace privacyPolicyUrl with your production policy URL before App Store / Play submission."
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}